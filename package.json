{
  "name": "trip-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "dev": "concurrently -k -n backend,frontend -c blue,green npm:dev:backend npm:dev:frontend",
    "dev:backend": "uv run -m uvicorn backend.main:app --reload --reload-dir backend",
    "dev:frontend": "vite frontend",
    "format": "uv run ruff format && uv run ruff check --fix && prettier --write -u .",
    "check": "node scripts/check.mjs",
    "build": "tsc && vite build frontend",
    "lint": "npm run lint:python && npm run lint:ts",
    "lint:python": "uv run ruff format --check && uv run ruff check && pyright",
    "lint:ts": "prettier --check -u . && eslint .",
    "test:unit": "uv run pytest backend/tests/unit --cov && vitest run --root frontend --coverage && node --test \".claude/hooks/*.test.mjs\" \"scripts/*.test.mjs\"",
    "test:integration": "uv run pytest backend/tests/integration",
    "test:e2e": "uv run pytest e2e --browser chromium --tracing retain-on-failure --screenshot only-on-failure --output test-results",
    "security": "uv run pip-audit && npm audit --audit-level=high && node scripts/check-secrets.mjs",
    "architecture": "uv run lint-imports",
    "metrics": "node scripts/metrics.mjs",
    "pr": "node scripts/open-pr.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/mcp": "^0.0.84",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "pyright": "^1.1.414",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "lefthook": false
  }
}
